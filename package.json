{
  "name": "greentube-test-flows",
  "version": "1.0.0",
  "private": true,
  "description": "Greentube test-automation assignment: the registration and login test document for GameTwist, and the Cucumber suite for the Swagger Petstore PET endpoints.",
  "type": "module",
  "engines": {
    "node": "^22.18.0 || ^24.0.0 || >=26.0.0"
  },
  "scripts": {
    "test": "cucumber-js",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm test",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write \"**/*.{js,cjs,mjs,ts,json,yml}\"",
    "format:check": "prettier --check \"**/*.{js,cjs,mjs,ts,json,yml}\""
  },
  "devDependencies": {
    "@cucumber/cucumber": "^13.2.1",
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.18.0",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.12.0",
    "prettier": "^3.9.9",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.70.1"
  }
}
